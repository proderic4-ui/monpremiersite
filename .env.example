# Variables d'environnement — copiez vers .env en local
# En production (Vercel), ajoutez ces 2 variables dans les réglages du projet.

# Base de données PostgreSQL (Neon, Supabase, Railway...)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Secret pour sécuriser les sessions (une longue phrase secrète, différente à chaque projet)
# Générez-en un avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=changez-moi-avec-une-longue-phrase-secrete-minimum-32-caracteres
